# Public, local-only demo configuration. Never use these credentials in deployment.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=55433
DB_USERNAME=tickr_demo
DB_PASSWORD=tickr_demo
DB_DATABASE=tickr_demo
DB_SYNCHRONIZE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=56380
JWT_SECRET=tickr-local-demo-secret-never-use-in-production
PAYMENT_GATEWAYS_ENABLED=false
OFFLINE_PAYMENT_ENABLED=false
PLATFORM_COMMISSION_RATE=0
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://127.0.0.1:4566
AWS_S3_ENDPOINT=http://127.0.0.1:4566
# Store and read timestamp columns consistently; UI formats Africa/Tunis explicitly.
TZ=UTC
