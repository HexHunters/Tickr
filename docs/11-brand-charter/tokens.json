{
  "name": "Tickr design charter",
  "version": "1.0.0",
  "description": "Source of truth for the proposed Tickr identity. Values target digital interfaces; the charter documents usage and print conversion.",
  "tokens": {
    "color": {
      "canvas": "#F7F9F8",
      "surface": "#FFFFFF",
      "ink": "#233A42",
      "muted": "#52656B",
      "action": "#315B64",
      "action-hover": "#264851",
      "line": "#D9E2E1",
      "control": "#75878C",
      "mist": "#DCEAF3",
      "sage": "#DDE9DF",
      "lilac": "#E7E1F0",
      "shell": "#F2DED7",
      "butter": "#F2EBCF",
      "night": "#203840",
      "success": "#32634F",
      "warning": "#76581C",
      "error": "#8D433F"
    },
    "font": {
      "ui": "'Manrope', sans-serif",
      "arabic": "'Readex Pro', sans-serif"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800"
    },
    "type": {
      "12": {
        "size": "12px",
        "line-height": "18px",
        "tracking": "0em"
      },
      "14": {
        "size": "14px",
        "line-height": "22px",
        "tracking": "0em"
      },
      "16": {
        "size": "16px",
        "line-height": "26px",
        "tracking": "0em"
      },
      "18": {
        "size": "18px",
        "line-height": "28px",
        "tracking": "-0.01em"
      },
      "24": {
        "size": "24px",
        "line-height": "32px",
        "tracking": "-0.02em"
      },
      "32": {
        "size": "32px",
        "line-height": "40px",
        "tracking": "-0.025em"
      },
      "48": {
        "size": "48px",
        "line-height": "56px",
        "tracking": "-0.04em"
      },
      "72": {
        "size": "72px",
        "line-height": "80px",
        "tracking": "-0.05em"
      },
      "96": {
        "size": "96px",
        "line-height": "104px",
        "tracking": "-0.055em"
      }
    },
    "space": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px",
      "32": "128px"
    },
    "radius": {
      "control": "8px",
      "card": "12px",
      "feature": "20px",
      "chip": "999px"
    },
    "focus": {
      "width": "3px",
      "offset": "3px"
    },
    "motion": {
      "fast": "160ms",
      "standard": "240ms",
      "deliberate": "420ms",
      "ease": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "layout": {
      "content": "1200px",
      "reading": "65ch",
      "gutter-mobile": "20px",
      "gutter-desktop": "48px",
      "target-min": "44px"
    }
  },
  "contrast": {
    "method": "WCAG 2.x relative luminance in sRGB, unrounded values used for pass/fail",
    "textMinimum": 4.5,
    "boundaryMinimum": 3,
    "textForegrounds": ["ink", "muted"],
    "lightBackgrounds": [
      "canvas",
      "surface",
      "mist",
      "sage",
      "lilac",
      "shell",
      "butter"
    ],
    "additionalTextPairs": [
      ["surface", "action"],
      ["surface", "action-hover"],
      ["surface", "night"],
      ["mist", "night"],
      ["success", "sage"],
      ["warning", "butter"],
      ["error", "shell"]
    ],
    "controlBoundaryPairs": [
      ["control", "surface"],
      ["control", "canvas"],
      ["control", "mist"],
      ["control", "butter"],
      ["action", "sage"],
      ["action", "lilac"],
      ["action", "shell"]
    ],
    "focusPairs": [
      ["action", "canvas"],
      ["action", "surface"],
      ["action", "mist"],
      ["action", "sage"],
      ["action", "lilac"],
      ["action", "shell"],
      ["action", "butter"],
      ["surface", "night"],
      ["mist", "night"]
    ],
    "notes": [
      "Use control only on surface, canvas, mist, or butter. Use action as the boundary on sage, lilac, or shell.",
      "Line is decorative and is not a sufficient sole boundary for an interactive control.",
      "Pastels are background fills, never text on white. Color must not be the only way to communicate status.",
      "These are palette checks, not a claim of whole-product accessibility conformance."
    ]
  }
}
